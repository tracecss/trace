{
  "name": "trace-css",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "editorconfig-checker": "7.0.0",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vite": "8.3.5"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "pnpm run check:styles && pnpm run check:format && pnpm run check:editorconfig",
    "check:styles": "stylelint \"**/*.css\" --max-warnings 0",
    "check:format": "prettier --check .",
    "check:editorconfig": "editorconfig-checker",
    "playground": "vite --port 3000 --open /playground/",
    "prepack": "pnpm check && pnpm build",
    "check:package": "node scripts/check-package.js"
  },
  "version": "0.1.0",
  "description": "CSS library for native HTML elements, design tokens, and light and dark themes.",
  "files": [
    "dist",
    "src"
  ],
  "style": "./dist/trace.css",
  "exports": {
    ".": "./dist/trace.css",
    "./dist/*.css": "./dist/*.css",
    "./src/*.css": "./src/*.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "unpkg": "./dist/trace.min.css",
  "jsdelivr": "./dist/trace.min.css",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.14.0",
      "onFail": "error"
    }
  }
}
